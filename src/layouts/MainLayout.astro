---
import CommonHead from "../components/CommonHead.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-dark-blue scroll-smooth font-sans">
  <CommonHead title={title} description={description} />
  <body class="relative m-0 mx-auto min-h-screen max-w-screen-2xl">
    <a
      href="#main-content"
      class="bg-primary text-light sr-only z-[100] rounded-lg px-4 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to content
    </a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
