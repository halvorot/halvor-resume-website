---
import CommonHead from "../components/CommonHead.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <CommonHead title={title} description={description} />
  <body class="relative m-0 min-h-screen">
    <a
      href="#main-content"
      class="bg-primary text-dark sr-only z-[100] min-h-11 items-center rounded-lg px-4 py-2 font-semibold focus:fixed focus:top-4 focus:left-4 focus:flex"
    >
      Skip to content
    </a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
