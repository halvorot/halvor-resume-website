---
import techLightsBackgroundImage from "../assets/images/tech-lights-bg.jpg";
import BackgroundSection from "./BackgroundSection.astro";
import CapabilityLevels from "./CapabilityLevels.astro";
import CertificationsCarousel from "./CertificationsCarousel.astro";
import GradientHeading from "./GradientHeading.astro";
import SectionHeading from "./SectionHeading.astro";
---

<BackgroundSection
  id="capabilities"
  image={techLightsBackgroundImage}
  opacity={0.2}
  contentClass="m-auto max-w-3xl p-4 text-light"
>
  <GradientHeading preText="My main " gradientText="capabilities" />
  <SectionHeading text="knowledge level in my main capabilities" />
  <CapabilityLevels />
  <SectionHeading text="Certifications" class="mt-20" />
  <CertificationsCarousel />
</BackgroundSection>
