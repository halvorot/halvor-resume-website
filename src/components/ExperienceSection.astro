---
import snowyMountainsBackgroundImage from "../assets/images/snowy-mountains-bg.jpg";
import BackgroundSection from "./BackgroundSection.astro";
import ExperienceTimeline from "./ExperienceTimeline.astro";
import GradientHeading from "./GradientHeading.astro";
import SectionHeading from "./SectionHeading.astro";
---

<BackgroundSection
  id="experience"
  image={snowyMountainsBackgroundImage}
  opacity={0.15}
  class="pb-20"
  contentClass="m-auto max-w-3xl p-4 text-light"
>
  <GradientHeading preText="My " gradientText="experience" />
  <SectionHeading text="Timeline" />
  <ExperienceTimeline />
</BackgroundSection>
