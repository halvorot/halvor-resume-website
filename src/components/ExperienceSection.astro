---
import ExperienceTimeline from "./ExperienceTimeline.astro";
---

<section
  id="experience"
  class="experience-section border-light-accent/10 border-b"
  aria-labelledby="experience-title"
>
  <div class="section-shell py-[var(--space-section)]">
    <header>
      <p class="section-kicker">Experience</p>
      <h2 id="experience-title" class="section-title">
        Professional experience
      </h2>
    </header>
    <ExperienceTimeline />
  </div>
</section>

<style>
  .experience-section {
    background:
      radial-gradient(
        circle at 10% 22%,
        rgb(255 255 255 / 0.035),
        transparent 28rem
      ),
      var(--color-dark);
  }
</style>
