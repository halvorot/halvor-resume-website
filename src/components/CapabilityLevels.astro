---
import { capabilities } from "../data/capabilities";
---

<table class="w-full">
  <caption class="sr-only">Self-assessed capability levels</caption>
  <tbody>
    {
      capabilities.map((capability) => (
        <tr class="h-12 w-full">
          <th scope="row" class="text-secondary text-right font-normal">
            <p class="mr-5">{capability.name}</p>
          </th>
          <td class="w-full">
            <div
              style={{ width: capability.levelPercent + "%" }}
              class="bg-primary h-3"
              role="progressbar"
              aria-label={`${capability.name} capability`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={capability.levelPercent}
            />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
