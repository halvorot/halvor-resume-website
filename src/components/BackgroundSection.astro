---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id?: string;
  image: ImageMetadata;
  opacity: number;
  position?: string;
  overlay?: string;
  class?: string;
  contentClass: string;
}

const {
  id,
  image,
  opacity,
  position = "center",
  overlay,
  class: className,
  contentClass,
} = Astro.props;

const optimizedImage = await getImage({ src: image });
const backgroundImage = overlay
  ? `${overlay}, url(${optimizedImage.src})`
  : `url(${optimizedImage.src})`;
---

<section
  {id}
  class:list={["background-section", className]}
  style={`--section-background-image: ${backgroundImage}; --section-background-opacity: ${opacity}; --section-background-position: ${position};`}
>
  <div class={contentClass}>
    <slot />
  </div>
</section>

<style>
  .background-section {
    isolation: isolate;
    position: relative;
  }

  .background-section::before {
    position: absolute;
    z-index: -10;
    top: 0;
    width: 100%;
    height: 100%;
    background-image: var(--section-background-image);
    background-position: var(--section-background-position);
    background-size: cover;
    background-repeat: no-repeat;
    content: "";
    opacity: var(--section-background-opacity);
  }
</style>
