---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  repoUrl: string;
  liveUrl?: string;
  image: ImageMetadata;
  imageAlt: string;
  featured?: boolean;
  status?: "decommissioned";
  customLogoBackgroundColor?: string;
  technologies?: string[];
}

const {
  title,
  description,
  repoUrl,
  liveUrl,
  image,
  imageAlt,
  status,
  customLogoBackgroundColor,
  technologies,
} = Astro.props;
---

<article
  class="border-light-accent/10 bg-dark-accent/75 text-light flex h-full rounded-[var(--radius-card)] border p-6 shadow-[var(--shadow-card)]"
>
  <div class="flex min-w-0 flex-1 items-stretch gap-4">
    <div
      class:list={[
        "flex h-12 w-12 shrink-0 items-center justify-center self-start overflow-hidden",
        customLogoBackgroundColor ? "rounded-xl p-2.5" : "p-1",
      ]}
      style={customLogoBackgroundColor
        ? `background-color: ${customLogoBackgroundColor}`
        : undefined}
    >
      <Image
        src={image}
        alt={imageAlt}
        class="h-full w-full object-contain"
        loading="lazy"
      />
    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h3
          class="text-xl leading-tight font-semibold tracking-tight text-balance"
        >
          {title}
        </h3>
        {
          status && (
            <span class="border-light-accent/15 bg-light/5 text-light-accent inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium tracking-[0.12em] uppercase">
              {status}
            </span>
          )
        }
      </div>
      <p class="text-light-accent mt-2 max-w-[52ch] text-sm leading-6">
        {description}
      </p>
      {
        technologies && (
          <ul
            class="mt-5 flex flex-wrap gap-2"
            aria-label={`${title} technologies`}
          >
            {technologies.map((technology) => (
              <li class="border-light-accent/15 bg-light/5 rounded-full border px-3 py-1 text-sm">
                {technology}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-auto flex flex-wrap items-center gap-2 pt-6">
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noreferrer"
              class="interactive-target border-primary/35 bg-primary/8 text-primary hover:border-primary/60 hover:bg-primary/12 hover:text-primary-hover inline-flex items-center justify-center gap-2 rounded-lg border px-4 text-sm font-semibold transition-colors"
            >
              <span>Live site</span>
              <Icon
                name="bi:box-arrow-up-right"
                class="h-4 w-4"
                aria-hidden="true"
              />
            </a>
          )
        }
        <a
          href={repoUrl}
          target="_blank"
          rel="noreferrer"
          class="interactive-target border-light-accent/25 bg-light/5 text-light hover:border-primary/60 hover:bg-light/10 inline-flex items-center justify-center gap-2 rounded-lg border px-4 text-sm font-semibold transition-colors"
        >
          <span>Repo</span>
          <Icon name="bi:github" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</article>
