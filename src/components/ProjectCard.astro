---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

type ImageType = {
  src: string;
  width: number;
  height: number;
  format: "svg" | "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "avif";
};

interface Props {
  title: string;
  description: string;
  repoUrl: string;
  liveUrl?: string;
  image: ImageType;
  imageAlt: string;
  featured?: boolean;
  status?: "decommissioned";
  logoBackgroundClass?: string;
  customLogoBackgroundColor?: string;
}

const {
  title,
  description,
  repoUrl,
  liveUrl,
  image,
  imageAlt,
  featured = false,
  status,
  logoBackgroundClass = "bg-dark",
  customLogoBackgroundColor,
} = Astro.props;
---

<article
  class:list={[
    "relative overflow-hidden rounded-3xl border border-light-accent/10 bg-dark-accent/80 p-5 text-left text-light shadow-[0_14px_40px_rgba(0,0,0,0.28)] backdrop-blur-sm",
    featured ? "grid gap-6 md:grid-cols-[auto_1fr]" : "flex h-full flex-col gap-4",
  ]}
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(253,186,116,0.16),transparent_34%),linear-gradient(180deg,rgba(255,255,255,0.04),transparent)]"></div>

  <div
    class:list={[
      "relative z-10 flex shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-light-accent/10",
      featured ? "h-28 w-28 p-5 md:h-32 md:w-32 md:p-6" : "h-16 w-16 p-3",
      logoBackgroundClass,
    ]}
    style={customLogoBackgroundColor
      ? `background-color: ${customLogoBackgroundColor}`
      : undefined}
  >
    <Image src={image} alt={imageAlt} class="h-full w-full object-contain" />
  </div>

  <div class="relative z-10 flex min-w-0 flex-1 flex-col">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h3 class:list={[featured ? "text-3xl" : "text-xl", "text-balance font-semibold leading-tight"]}>
          {title}
        </h3>
        <p class:list={[featured ? "mt-3 text-base" : "mt-2 text-sm", "max-w-[42ch] text-light-accent"]}>
          {description}
        </p>
      </div>
      {status && (
        <span class="inline-flex items-center rounded-full border border-light-accent/15 bg-light-accent/8 px-3 py-1 text-xs font-medium uppercase tracking-[0.14em] text-light-accent">
          {status}
        </span>
      )}
    </div>

    <div class="mt-5 flex flex-wrap gap-3">
      <a
        href={repoUrl}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-medium text-light transition hover:bg-primary-accent"
      >
        <span>Repo</span>
        <Icon name="bi:github" class="h-4 w-4" />
      </a>
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-light-accent/15 bg-light-accent/8 px-4 py-2 text-sm font-medium text-light transition hover:border-secondary/45 hover:bg-light-accent/12"
        >
          <span>Live site</span>
          <Icon name="bi:box-arrow-up-right" class="h-4 w-4" />
        </a>
      )}
    </div>
  </div>
</article>
