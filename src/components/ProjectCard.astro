---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  repoUrl: string;
  liveUrl?: string;
  image: ImageMetadata;
  imageAlt: string;
  featured?: boolean;
  status?: "decommissioned";
  customLogoBackgroundColor?: string;
  technologies?: string[];
}

const {
  title,
  description,
  repoUrl,
  liveUrl,
  image,
  imageAlt,
  featured = false,
  status,
  customLogoBackgroundColor,
  technologies,
} = Astro.props;
---

<article
  class:list={[
    "border-light-accent/10 bg-dark-accent/80 text-light relative overflow-hidden rounded-[var(--radius-card)] border p-5 shadow-[var(--shadow-card)]",
    featured
      ? "grid items-center gap-6 md:grid-cols-[7rem_minmax(0,1fr)_auto] md:p-7"
      : "flex h-full flex-col gap-4",
  ]}
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(249,115,22,0.11),transparent_38%),linear-gradient(180deg,rgba(255,255,255,0.025),transparent)]"
  >
  </div>

  <div
    class:list={[
      "border-light-accent/10 bg-dark relative z-10 flex shrink-0 items-center justify-center overflow-hidden rounded-2xl border",
      featured ? "h-24 w-24 p-5 md:h-28 md:w-28" : "h-16 w-16 p-3",
    ]}
    style={customLogoBackgroundColor
      ? `background-color: ${customLogoBackgroundColor}`
      : undefined}
  >
    <Image
      src={image}
      alt={imageAlt}
      class="h-full w-full object-contain"
      loading="lazy"
    />
  </div>

  <div class="relative z-10 min-w-0 flex-1">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h3
        class:list={[
          featured ? "text-2xl md:text-3xl" : "text-xl",
          "leading-tight font-semibold tracking-tight text-balance",
        ]}
      >
        {title}
      </h3>
      {
        status && (
          <span class="border-light-accent/15 bg-light/5 text-light-accent inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium tracking-[0.12em] uppercase">
            {status}
          </span>
        )
      }
    </div>
    <p
      class:list={[
        featured ? "mt-3 text-base" : "mt-2 text-sm",
        "text-light-accent max-w-[48ch] leading-6",
      ]}
    >
      {description}
    </p>
    {
      technologies && (
        <ul
          class="mt-4 flex flex-wrap gap-2"
          aria-label={`${title} technologies`}
        >
          {technologies.map((technology) => (
            <li class="border-light-accent/15 bg-light/5 rounded-full border px-3 py-1 text-xs">
              {technology}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div
    class:list={[
      "relative z-10 flex flex-wrap gap-3",
      featured ? "md:flex-col md:items-stretch" : "mt-auto pt-2",
    ]}
  >
    {
      liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noreferrer"
          class="interactive-target bg-primary text-dark hover:bg-primary-hover inline-flex items-center justify-center gap-2 rounded-lg px-4 text-sm font-bold transition-colors"
        >
          <span>Live site</span>
          <Icon
            name="bi:box-arrow-up-right"
            class="h-4 w-4"
            aria-hidden="true"
          />
        </a>
      )
    }
    <a
      href={repoUrl}
      target="_blank"
      rel="noreferrer"
      class="interactive-target border-light-accent/15 bg-light/5 text-light hover:border-primary/50 inline-flex items-center justify-center gap-2 rounded-lg border px-4 text-sm font-semibold transition-colors"
    >
      <span>Repo</span>
      <Icon name="bi:github" class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</article>
