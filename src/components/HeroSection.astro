---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import halvorBackgroundImage from "../assets/images/halvor-bg.jpg";

const certificationCount = (await getCollection("certifications")).length;
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    src={halvorBackgroundImage}
    alt=""
    class="hero-image"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>

  <div
    class="section-shell relative z-10 flex min-h-[clamp(38rem,78vh,45rem)] items-center py-20"
  >
    <div class="max-w-[38rem]">
      <p class="section-kicker hero-kicker">Hi, I’m</p>
      <h1 id="hero-title" class="hero-name">Halvor Ødegård Teigen</h1>
      <p class="text-hero-text mt-7 text-xl font-semibold sm:text-2xl">
        Backend developer & Platform Enthusiast
      </p>
      <div class="text-hero-text-muted mt-5 max-w-[38rem] leading-7">
        <p>
          <strong class="text-hero-text font-semibold">
            Everything can be learned.
          </strong>{" "}
          That mindset means taking on new problems, doing work I'm proud of, improving
          along the way, and sharing knowledge with the team.
        </p>
      </div>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#experience"
          class="interactive-target bg-primary text-on-accent hover:bg-primary-hover inline-flex items-center justify-center rounded-lg px-6 font-bold transition-colors"
        >
          View experience
        </a>
        <a
          href="#contact"
          class="interactive-target secondary-action inline-flex items-center justify-center rounded-lg px-6 font-semibold"
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</section>

<section
  class="border-light-accent/10 bg-dark border-y"
  aria-label="Professional overview"
>
  <div
    class="section-shell divide-light-accent/10 grid divide-y sm:grid-cols-3 sm:divide-x sm:divide-y-0"
  >
    <div
      class="flex min-h-24 flex-col justify-center py-5 sm:px-6 sm:first:pl-0"
    >
      <span class="text-light-accent text-xs tracking-[0.16em] uppercase">
        Role
      </span>
      <strong class="mt-1 font-semibold">Senior Software Engineer</strong>
    </div>
    <div class="flex min-h-24 flex-col justify-center py-5 sm:px-6">
      <span class="text-light-accent text-xs tracking-[0.16em] uppercase">
        Certifications
      </span>
      <strong class="mt-1 font-semibold">
        <span data-certification-count>{certificationCount}</span>{" "}
        certifications
      </strong>
    </div>
    <div class="flex min-h-24 flex-col justify-center py-5 sm:pr-0 sm:pl-6">
      <span class="text-light-accent text-xs tracking-[0.16em] uppercase">
        Focus
      </span>
      <strong class="mt-1 font-semibold">Kotlin · Platform · DevEx</strong>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-background);
  }

  .hero-image,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    left: auto;
    width: min(60vw, 62rem);
    object-fit: cover;
    object-position: 50% 14%;
    opacity: var(--hero-image-opacity);
    filter: saturate(0.78) brightness(0.82);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 32%);
    mask-image: linear-gradient(to right, transparent 0%, black 32%);
  }

  .hero-overlay {
    background: var(--hero-overlay);
  }

  .hero-name {
    max-width: 13ch;
    margin-top: 0.35rem;
    color: var(--hero-text);
    font-size: var(--text-display);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero-kicker {
    color: var(--hero-accent);
  }

  @media (max-width: 47.99rem) {
    .hero-image {
      width: 100%;
      object-position: 64% 14%;
      filter: saturate(0.72) brightness(0.7);
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero-overlay {
      background: var(--hero-mobile-overlay);
    }
  }
</style>
