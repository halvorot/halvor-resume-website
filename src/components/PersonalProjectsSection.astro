---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

const featuredProject = projects.find((project) => project.featured);
const standardProjects = projects
  .filter((project) => !project.featured)
  .sort(
    (left, right) =>
      Number(Boolean(right.liveUrl)) - Number(Boolean(left.liveUrl)),
  );
---

<section
  id="personal-projects"
  class="projects-section"
  aria-labelledby="projects-title"
>
  <div class="section-shell py-[var(--space-section)]">
    <header>
      <p class="section-kicker">Projects</p>
      <h2 id="projects-title" class="section-title">Personal projects</h2>
      <p class="text-light-accent mt-5 max-w-2xl text-lg leading-8">
        Self-hosted infrastructure, developer tooling, and selected applications
        built for learning and experimentation.
      </p>
    </header>

    {
      featuredProject && (
        <div class="mt-12">
          <ProjectCard {...featuredProject} />
        </div>
      )
    }

    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {standardProjects.map((project) => <ProjectCard {...project} />)}
    </div>
  </div>
</section>

<style>
  .projects-section {
    background:
      radial-gradient(
        circle at 82% 18%,
        rgb(249 115 22 / 0.08),
        transparent 28rem
      ),
      var(--color-dark-blue);
  }
</style>
