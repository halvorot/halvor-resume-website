---
import snowyMountainsBackgroundImage from "../assets/images/snowy-mountains-bg.jpg";
import { projects } from "../data/projects";
import BackgroundSection from "./BackgroundSection.astro";
import GradientHeading from "./GradientHeading.astro";
import ProjectCard from "./ProjectCard.astro";

const featuredProject = projects.find((project) => project.featured);
const standardProjects = projects
  .filter((project) => !project.featured)
  .sort(
    (left, right) =>
      Number(Boolean(right.liveUrl)) - Number(Boolean(left.liveUrl)),
  );
---

<BackgroundSection
  id="personal-projects"
  image={snowyMountainsBackgroundImage}
  opacity={0.22}
  overlay="linear-gradient(180deg, rgba(10, 10, 10, 0.84), rgba(10, 10, 10, 0.78))"
  class="pb-20"
  contentClass="m-auto max-w-5xl p-4 text-light"
>
  <GradientHeading preText="My personal " gradientText="projects" />
  <div class="mx-auto mb-14 max-w-2xl text-center">
    <p class="text-light-accent text-base leading-7">
      A handfull of personal projects I have worked on to learn and experiment.
      Ranging from self-hosted infrastructure to live web applications.
    </p>
  </div>

  {
    featuredProject && (
      <div class="mb-8">
        <ProjectCard {...featuredProject} />
      </div>
    )
  }

  <div class="grid gap-5 md:grid-cols-2">
    {standardProjects.map((project) => <ProjectCard {...project} />)}
  </div>
</BackgroundSection>
