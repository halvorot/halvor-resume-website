---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config/site";
---

<footer class="bg-dark bg-opacity-80 sticky top-[100vh]">
  <div
    class="mx-auto flex w-full max-w-screen-xl flex-col items-center justify-center p-4 py-4 text-center sm:flex-row sm:justify-between sm:text-left"
  >
    <div class="text-light text-xs md:text-sm">
      <p>
        Developed by Halvor Ødegård Teigen using <a
          class="underline"
          href="https://astro.build/"
          target="_blank"
          rel="noreferrer"
          >Astro<Icon
            name="bi:box-arrow-up-right"
            class="inline h-2 w-2 align-super md:h-3 md:w-3"
          /></a
        >
      </p>
    </div>
    <div class="mt-4 flex items-center space-x-5 sm:mt-0">
      <a href={siteConfig.links.linkedin} target="_blank" rel="noreferrer">
        <Icon
          class="text-light hover:text-light-accent h-6 w-6"
          aria-hidden="true"
          name="bi:linkedin"
        />
        <span class="sr-only">LinkedIn account</span>
      </a>
      <a href={siteConfig.links.github} target="_blank" rel="noreferrer">
        <Icon
          class="text-light hover:text-light-accent h-6 w-6"
          aria-hidden="true"
          name="bi:github"
        />
        <span class="sr-only">GitHub account</span>
      </a>
    </div>
  </div>
</footer>
