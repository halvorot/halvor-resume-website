---
interface Props {
  level?: 1 | 2;
  preText: string;
  gradientText: string;
}

const { level = 2, preText, gradientText } = Astro.props;
const Heading = `h${level}` as const;
---

<Heading class="mt-20 mb-16 text-center text-6xl leading-tight font-bold">
  {preText}
  <span
    class="from-primary to-secondary-accent bg-gradient-to-r from-10% bg-clip-text text-transparent"
  >
    {gradientText}
  </span>
</Heading>
