---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config/site";
import { navigation } from "../data/navigation";
---

<nav
  aria-label="Main navigation"
  class="border-light-accent/10 bg-dark-blue/90 sticky top-0 z-50 border-b backdrop-blur-xl"
>
  <div
    class="section-shell flex min-h-16 items-center justify-between gap-5 py-2"
  >
    <a
      href="/"
      class="interactive-target text-light inline-flex items-center gap-3 rounded-lg"
      aria-label="Halvor Ødegård Teigen, home"
    >
      <Icon name="h-logo" class="h-9 w-9 shrink-0" />
      <span class="hidden text-base font-semibold sm:block">
        {siteConfig.shortName}
      </span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navigation.map((item) => (
          <a
            href={item.path}
            data-section-link={item.path.split("#")[1]}
            class="interactive-target text-light-accent hover:text-light inline-flex items-center rounded-lg px-4 text-sm font-semibold transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <a
        href={siteConfig.links.cv}
        target="_blank"
        rel="noreferrer"
        class="interactive-target group ml-3 inline-flex items-center rounded-lg text-sm font-bold"
      >
        <span
          class="bg-primary text-dark group-hover:bg-primary-hover inline-flex h-9 items-center rounded-md px-4 transition-colors"
        >
          Download CV
        </span>
      </a>
    </div>

    <button
      id="menu-btn"
      type="button"
      class="interactive-target text-light hover:bg-light/8 inline-flex items-center justify-center rounded-lg transition-colors lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Open main menu</span>
      <Icon name="bi:list" class="h-7 w-7" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="border-light-accent/10 bg-dark-blue hidden border-t lg:hidden"
  >
    <div class="section-shell flex flex-col py-3">
      {
        navigation.map((item) => (
          <a
            href={item.path}
            data-section-link={item.path.split("#")[1]}
            class="interactive-target text-light-accent hover:text-light hover:bg-light/5 flex items-center rounded-lg px-3 font-semibold transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <div
        class="border-light-accent/10 mt-2 grid gap-2 border-t pt-4 sm:grid-cols-2"
      >
        <a
          href={siteConfig.links.linkedin}
          target="_blank"
          rel="noreferrer"
          class="interactive-target border-light-accent/15 text-light hover:border-primary/50 inline-flex items-center justify-center rounded-lg border px-4 text-sm font-semibold transition-colors"
        >
          LinkedIn
        </a>
        <a
          href={siteConfig.links.cv}
          target="_blank"
          rel="noreferrer"
          class="interactive-target bg-primary text-dark hover:bg-primary-hover inline-flex items-center justify-center rounded-lg px-4 text-sm font-bold transition-colors"
        >
          Download CV
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  [data-section-link][aria-current="location"] {
    color: var(--color-primary);
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-btn");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const navigationElement = document.querySelector<HTMLElement>("nav");

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menuButton?.setAttribute("aria-expanded", String(open));
    menuButton
      ?.querySelector(".sr-only")
      ?.replaceChildren(open ? "Close main menu" : "Open main menu");
  };

  menuButton?.addEventListener("click", () => {
    setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.documentElement.addEventListener("click", () => setMenuOpen(false));
  navigationElement?.addEventListener("click", (event) =>
    event.stopPropagation(),
  );
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      menuButton?.getAttribute("aria-expanded") === "true"
    ) {
      setMenuOpen(false);
      menuButton.focus();
    }
  });

  const sectionLinks = document.querySelectorAll<HTMLAnchorElement>(
    "[data-section-link]",
  );
  const sections = [...sectionLinks]
    .map((link) => link.dataset.sectionLink)
    .filter(
      (id, index, ids): id is string =>
        Boolean(id) && ids.indexOf(id) === index,
    )
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  const setActiveSection = (id: string) => {
    sectionLinks.forEach((link) => {
      if (link.dataset.sectionLink === id) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  if ("IntersectionObserver" in window && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (left, right) => right.intersectionRatio - left.intersectionRatio,
          )[0];
        if (visible?.target.id) setActiveSection(visible.target.id);
      },
      { rootMargin: "-20% 0px -65%", threshold: [0, 0.1, 0.4] },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
