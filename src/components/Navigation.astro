---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config/site";
import { navigation } from "../data/navigation";
import LinkButton from "./LinkButton.astro";

const isHomePage = Astro.url.pathname === "/";
---

<nav
  aria-label="Main navigation"
  class="bg-dark-blue/70 border-light-accent/10 absolute z-50 w-full border-b shadow-[0_8px_30px_rgba(0,0,0,0.16)] backdrop-blur-xl"
>
  <div
    class="mx-auto flex max-w-screen-xl flex-wrap items-center justify-between gap-4 p-4"
  >
    <div class="flex items-center lg:flex-1">
      <Icon name="h-logo" class="mr-3 h-10 w-10" />
      <span
        class="text-light hidden text-2xl font-semibold capitalize sm:block"
      >
        {siteConfig.shortName}
      </span>
    </div>
    <div class="flex justify-end gap-2 lg:order-2 lg:flex-1 lg:gap-4">
      <div class="hidden lg:flex lg:justify-center">
        <LinkButton
          text="Contact on LinkedIn"
          href={siteConfig.links.linkedin}
          ariaLabel="Contact me on LinkedIn"
          variant="secondary"
        />
      </div>
      <LinkButton
        text="Download CV"
        href={siteConfig.links.cv}
        ariaLabel="Download CV"
      />
      <button
        id="menu-btn"
        type="button"
        class="text-light hover:bg-dark-accent/30 focus:ring-light-accent/10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg p-2 text-sm focus:ring-2 focus:outline-none lg:hidden"
        aria-controls="navbar-cta"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="h-5 w-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>
    </div>
    <div
      class="hidden w-full items-center justify-center lg:order-1 lg:flex lg:w-auto lg:flex-1"
      id="navbar-cta"
    >
      <ul
        class="mt-4 flex flex-col bg-transparent p-4 font-medium md:space-x-4 lg:mt-0 lg:flex-row lg:space-x-8 lg:p-0"
      >
        {
          navigation.map((item) => (
            <li class="text-light hover:text-secondary block bg-transparent py-2 pr-4 pl-3 lg:p-0">
              <a
                href={item.path}
                aria-current={
                  item.name === "Home" && isHomePage ? "page" : undefined
                }
                class="whitespace-nowrap"
              >
                {item.name}
              </a>
            </li>
          ))
        }
        <li class="xs:ml-0 xs:mt-0 mt-2 ml-3 lg:hidden">
          <LinkButton
            text="Contact on LinkedIn"
            href={siteConfig.links.linkedin}
            ariaLabel="Contact me on LinkedIn"
            variant="secondary"
          />
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  @reference "../styles/global.css";

  [aria-current="page"] {
    @apply text-primary;
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-btn");
  const menu = document.querySelector<HTMLElement>("#navbar-cta");
  const navigationElement = document.querySelector<HTMLElement>("nav");

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menuButton?.setAttribute("aria-expanded", String(open));
  };

  menuButton?.addEventListener("click", () => {
    setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.documentElement.addEventListener("click", () => setMenuOpen(false));
  navigationElement?.addEventListener("click", (event) =>
    event.stopPropagation(),
  );
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      menuButton?.getAttribute("aria-expanded") === "true"
    ) {
      setMenuOpen(false);
      menuButton?.focus();
    }
  });
</script>
