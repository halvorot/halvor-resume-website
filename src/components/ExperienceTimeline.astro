---
import TagTile from "./TagTile.astro";
import { getCollection } from "astro:content";

const experiences = await getCollection("experience");
const orderedExperiences = [...experiences].sort(
  (left, right) =>
    right.data.startDate.getTime() - left.data.startDate.getTime(),
);
---

<ol class="mt-14">
  {
    orderedExperiences.map((experience) => {
      const {
        startDate,
        endDate,
        heading,
        subHeading,
        consultingFirm,
        description,
        tags,
      } = experience.data;
      const dateLabel =
        endDate === undefined
          ? `${startDate.getFullYear()}–Present`
          : startDate.getFullYear() === endDate.getFullYear()
            ? `${startDate.getFullYear()}`
            : `${startDate.getFullYear()}–${endDate.getFullYear()}`;

      return (
        <li class="experience-entry border-light-accent/10 relative grid border-t py-9 md:grid-cols-[10rem_1fr] md:gap-10">
          <p class="text-primary mb-4 text-sm font-bold tracking-[0.08em] md:mb-0 md:pt-1">
            {dateLabel}
          </p>
          <article>
            <h3 class="text-2xl font-semibold tracking-tight">{heading}</h3>
            <p class="text-light mt-1 font-medium">{subHeading}</p>
            {consultingFirm && (
              <p class="text-primary mt-2 text-xs font-bold tracking-[0.12em] uppercase">
                Consulting project at {consultingFirm}
              </p>
            )}
            <p class="text-light-accent mt-4 max-w-[58rem] leading-7">
              {description}
            </p>
            {tags && (
              <ul
                class="mt-5 flex flex-wrap gap-2"
                aria-label={`${heading} technologies and areas`}
              >
                {tags.map((tag) => (
                  <li>
                    <TagTile text={tag} />
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .experience-entry::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 3.5rem;
    height: 2px;
    background: var(--color-primary);
    content: "";
  }
</style>
